<html>
<head>
<title>JN Music - Junior Ngoleka</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
body{background:#000;color:#fff;font-family:Arial;padding:15px;margin:0}
.logo{width:120px;height:120px;margin:20px auto;background:radial-gradient(circle,#222,#000);border:3px solid gold;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:50px;font-weight:bold;color:gold;text-align:center;box-shadow:0 0 20px gold}
.title{color:gold;text-align:center;font-size:24px;font-weight:bold;margin:15px 0}
.song{border:2px solid gold;border-radius:15px;padding:15px;margin:15px 0;background:#0a0a0a}
.song.new{border-color:#ffcc00}
.song.most{border-color:red}
.badge{font-size:11px;padding:3px 8px;border-radius:5px;font-weight:bold;margin-left:8px}
.badge-new{background:gold;color:#000}
.badge-most{background:red;color:#fff}
.plays{color:#aaa;font-size:13px;margin:5px 0}
audio{width:100%;margin:10px 0}
.btn-dl{background:#ffcc00;color:#000;border:none;padding:10px 18px;border-radius:8px;font-weight:bold;cursor:pointer}
.btn-like{background:#222;color:#fff;border:1px solid #555;padding:6px 14px;border-radius:20px;cursor:pointer;margin-top:10px}
.btn-like.liked{background:red;border-color:red}
.comment-row{display:flex;gap:6px;margin-top:12px}
.comment-row input{flex:1;padding:9px 14px;border-radius:20px;border:none;background:#1a1a1a;color:#fff}
.btn-post{background:gold;color:#000;border:none;padding:9px 15px;border-radius:20px;font-weight:bold;cursor:pointer}
.comment-item{background:#1e1e1e;padding:8px 12px;border-radius:12px;margin-top:8px;text-align:left;font-size:14px}
.comment-item b{color:gold}
</style>
</head>
<body>

<div class="logo">JN</div>
<div class="title">🔥 NEW RELEASED</div>

<!-- SONG 1 -->
<div class="song new">
<div><b>Chimayaka</b><span class="badge badge-new">NEW</span></div>
<div class="plays">👁 1.2k plays • 3 days ago</div>
<audio controls><source src=""></audio>
<br><button class="btn-dl">Download MP3</button>
<br><button class="btn-like" onclick="likeThis(this)">❤️ <span>0</span> Likes</button>
<div class="comment-row"><input id="c1" placeholder="Add a comment..."><button class="btn-post" onclick="postThis('c1','l1')">Post</button></div>
<div id="l1"></div>
</div>

