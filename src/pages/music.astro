<script>
function likeSong(btn){
  const span = btn.querySelector('.likes');
  let count = parseInt(span.textContent);
  if(btn.classList.contains('liked')){
    count--; btn.classList.remove('liked');
  } else {
    count++; btn.classList.add('liked');
    btn.innerHTML = '❤️ Liked <span class="likes">'+count+'</span>';
    setTimeout(()=>{btn.innerHTML = '❤️ Liked <span class="likes">'+count+'</span>';},0);
  }
  span.textContent = count;
  // Save to local storage
  const song = btn.closest('.song-card').dataset.song;
  localStorage.setItem('like_'+song, count);
  localStorage.setItem('liked_'+song, btn.classList.contains('liked'));
}
function addComment(input){
  if(!input.value.trim()) return;
  const list = input.parentElement.querySelector('.comment-list');
  const div = document.createElement('div');
  div.className='comment';
  div.textContent = input.value;
  list.appendChild(div);
  input.value='';
  // Save comments
